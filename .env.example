# Copy to .env. Never commit .env.

# PostgreSQL (docker compose). Use a long random value.
POSTGRES_PASSWORD=

# Set in production. Unset locally = embedded PGlite in REGENT_DATA_DIR.
# DATABASE_URL=postgres://regent:<password>@host:5432/regent
# REGENT_DATA_DIR=.data/pglite

# HTTP
# PORT=8787
# HOST=127.0.0.1
# Comma-separated origins allowed to make credentialed requests (strict CORS).
# REGENT_ALLOWED_ORIGINS=https://regent.example.com
# true behind HTTPS (production default). Set false only for plain-HTTP local runs.
# REGENT_COOKIE_SECURE=true
# Number of trusted reverse proxies in front of REGENT that append to X-Forwarded-For.
# The client address is taken that many entries from the RIGHT (left entries are forgeable).
# REGENT_TRUST_PROXY_HOPS=0

# Demo personas (password-less sign-in as admin/analyst/auditor/viewer of the
# fictional Acme organisation). Turn off for any deployment holding real data.
REGENT_DEMO_MODE=true

# Optional bootstrap administrator with a password. Leave empty to skip.
REGENT_ADMIN_EMAIL=
REGENT_ADMIN_PASSWORD=

# Limits
# REGENT_MAX_IMPORT_BYTES=5242880
# REGENT_SESSION_HOURS=8
# REGENT_LOG_LEVEL=info
